{
  "name": "react-slack-login",
  "version": "2.1.0",
  "description": "A Slack OpenID Connect Sign in with Slack button for React",
  "main": "dist/react-slack-login.js",
  "scripts": {
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "dev": "vite build --watch",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hectorbenitez/react-slack-login.git"
  },
  "keywords": [
    "slack",
    "oauth",
    "react",
    "login",
    "signin",
    "openid",
    "openid-connect",
    "sign-in-with-slack"
  ],
  "author": "Hector Benitez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hectorbenitez/react-slack-login/issues"
  },
  "homepage": "https://github.com/hectorbenitez/react-slack-login#readme",
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "module": "dist/react-slack-login.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-slack-login.mjs",
      "require": "./dist/react-slack-login.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
